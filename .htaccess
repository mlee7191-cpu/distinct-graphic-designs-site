RewriteEngine On

# One hop to https + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://distinctgraphicdesigns.com.au%{REQUEST_URI} [L,R=301]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# /folder/index.html -> /folder/
RewriteCond %{THE_REQUEST} \s/(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [L,R=301]

# Vanity tracking links for the resume PDF: /portfolio-<code> -> /portfolio/ with UTM params attached,
# so the printed/shared link stays clean but the click is tagged (e.g. /portfolio-CPX)
RewriteRule ^portfolio-([A-Za-z0-9]+)$ /portfolio/?utm_source=resume&utm_medium=pdf&utm_campaign=$1 [L,R=301,NC]

# Safety net for the common "porfolio" (missing t) misspelling of the link above, already handed out to at least one employer
RewriteRule ^porfolio-([A-Za-z0-9]+)$ /portfolio/?utm_source=resume&utm_medium=pdf&utm_campaign=$1 [L,R=301,NC]

# WordPress is no longer used: answer 404 for its leftover folders and files (nothing is deleted, they are still on the server)
RewriteRule ^(wp-admin|wp-includes|wp-content)(/|$) - [R=404,L,NC]
RewriteRule ^(wp-[a-z-]+\.php|xmlrpc\.php|index\.php|readme\.html|license\.txt)$ - [R=404,L,NC]

# No directory listings (/assets/ and /assets/fonts/ currently show an "Index of" page)
Options -Indexes

# The enquiry settings file (database password) belongs one level above public_html. If it is ever put here by mistake, never serve it.
<Files "enquiry-config.php">
  Require all denied
</Files>

# The email templates are only included by enquire.php, never requested directly (enquiry-autoreply.php is the old name).
<FilesMatch "^enquiry-(emails|autoreply)\.php$">
  Require all denied
</FilesMatch>

# Custom 404 page (unknown URLs used to fall through to WordPress and return 503)
ErrorDocument 404 /404.html

# Security headers (no CSP: GTM and PostHog inject scripts)
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Caching: the fonts never change, so a year; images a month. CSS and JS stay at the server default (a week) because their names are not hashed.
  <FilesMatch "\.(woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html index.php

# WordPress rewrite block disabled: WordPress is no longer used on this site, so unknown URLs now get the real 404 (ErrorDocument above).
# To re-enable WordPress, remove the leading '#' from each line between BEGIN and END.
# BEGIN WordPress
