RewriteEngine On

# One hop to https + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://distinctgraphicdesigns.com.au%{REQUEST_URI} [L,R=301]

# /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [L,R=301]

# /folder/index.html -> /folder/
RewriteCond %{THE_REQUEST} \s/(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [L,R=301]

# WordPress is no longer used: answer 404 for its leftover folders and files (nothing is deleted, they are still on the server)
RewriteRule ^(wp-admin|wp-includes|wp-content)(/|$) - [R=404,L,NC]
RewriteRule ^(wp-[a-z-]+\.php|xmlrpc\.php|index\.php|readme\.html|license\.txt)$ - [R=404,L,NC]

# No directory listings (/assets/ and /assets/fonts/ currently show an "Index of" page)
Options -Indexes

# Custom 404 page (unknown URLs used to fall through to WordPress and return 503)
ErrorDocument 404 /404.html

DirectoryIndex index.html index.php

# WordPress rewrite block disabled: WordPress is no longer used on this site, so unknown URLs now get the real 404 (ErrorDocument above).
